# ============================================================
# abs-webnovel + Byparr — environment configuration
#
# Copy this file to `.env` (same directory as compose.yaml) and
# adjust the values. `compose.yaml` reads `.env` both for ${VAR}
# interpolation (ports) and passes it to both containers via
# `env_file`.
# ============================================================

# ---------- abs-webnovel ----------

# Host port for the abs-webnovel API (the container always listens on 8080).
WEBNOVEL_PORT=8080

# Comma-separated source priority, highest first.
# Available sources: anilist, mangadex, ranobedb, myanimelist, novelupdates,
#                    webnovel, novelbuddy
SOURCE_PRIORITY=anilist,mangadex,ranobedb,myanimelist,novelupdates,webnovel,novelbuddy

# Merge strategy:
#   priority — interleave results by source priority, dedupe by title (default)
#   first    — first non-empty source wins
MERGE_MODE=priority

# Maximum number of results returned per search.
SEARCH_LIMIT=5

# Prefer romaji titles over native scripts (true/false).
PREFER_ROMAJI=true

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# MyAnimeList client ID (https://myanimelist.net/apiconfig).
# Leave empty to disable the MAL source.
MAL_CLIENT_ID=

# URL of the Byparr instance used for the Cloudflare bypass (NovelUpdates,
# Webnovel). Point it at the byparr service in this stack, or an external
# instance. Leave empty to disable the bypass (those sources will be skipped).
BYPARR_URL=http://byparr:8191

# Rate limiting: at most RATE_LIMIT requests per RATE_PERIOD seconds.
RATE_LIMIT=60
RATE_PERIOD=60

# ---------- Byparr ----------

# Host port for Byparr (the container always listens on 8191).
BYPARR_PORT=8191

# Optional proxy for Byparr's headless browser (protocol://host:port).
# Leave empty for no proxy.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Browser locale (BCP-47 tag) and timezone (IANA name).
# Setting both skips Byparr's GeoIP lookup.
BROWSER_LOCALE=en-US
BROWSER_TIMEZONE=Europe/Berlin
